{
  "name": "pi-study-helper",
  "version": "0.1.0",
  "description": "Pi Study Helper — Task-driven study assistant organized by Loop Graph SDK for learning sessions, reviews, and profile management",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "fixtures/profiles/demo-review",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CYM2006CYM/Pluggable-personalized-AI-learning-workstation.git",
    "directory": "pi-study-helper"
  },
  "homepage": "https://github.com/CYM2006CYM/Pluggable-personalized-AI-learning-workstation/tree/main/pi-study-helper#readme",
  "bugs": {
    "url": "https://github.com/CYM2006CYM/Pluggable-personalized-AI-learning-workstation/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./src/extension/index.ts",
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:web": "vitest run tests/web",
    "dev:web": "vite --host 127.0.0.1",
    "build:demo": "tsc -p tsconfig.demo.json",
    "demo": "npm run build:demo && npm run build:web && node .demo-build/demo/launcher.js",
    "demo:live": "npm run build:demo && npm run build:web && node .demo-build/demo/launcher.js --live",
    "build:web": "vite build",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:history": "node scripts/check-history.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm test -- --maxWorkers=1 && npm run check:docs && npm run smoke:extension && npm run check:release",
    "verify:open-source": "npm run verify && npm run check:history && npm run audit:prod && npm run audit:all && npm pack --dry-run",
    "smoke:extension": "node scripts/smoke-extension.mjs",
    "probe:sdk-agent": "node scripts/run-sdk-agent-probe.mjs"
  },
  "dependencies": {
    "pi-loop-graph-sdk": "github:0liveiraaa/pi-loop-graph-sdk#401d3e9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "zustand": "5.0.14"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.3",
    "@earendil-works/pi-tui": "0.80.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "26.1.0",
    "typebox": "1.3.5",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "protobufjs": "7.6.5",
    "undici": "8.9.0"
  }
}
